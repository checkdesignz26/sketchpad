{
  "name": "sketchpad",
  "version": "1.0.0",
  "private": true,
  "description": "SketchPad by Seamless Creative. Same HTML app for the browser, the suite and the iPad.",
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build:web && npx cap sync ios",
    "ios:configure": "bash scripts/configure-ios.sh"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
